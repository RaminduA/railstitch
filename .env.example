# PostgreSQL
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=railstitch_db

# Comma separated admin emails: set to the grader's Google account email(s)
ADMIN_EMAILS=grader@gmail.com,another@gmail.com

# HMAC secret for ticket verification tokens
HMAC_SECRET=your-hmac-secret-change-in-production

# NextAuth (set in frontend/.env.local for local dev)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret